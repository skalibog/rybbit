# Caddyfile
{
    auto_https off
}

:3003 {
    # Enable compression
    encode zstd gzip

    request_body max_size 10MB

    # Handle CORS preflight for all paths
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, x-captcha-response, x-private-key"
        header Access-Control-Max-Age "86400"
        respond 204
    }

    # Add CORS headers to all API responses (Keenetic strips Origin, so backend can't set them)
    @api path /api/*
    header @api Access-Control-Allow-Origin "*"

    # Backend API and tracking script
    handle /api/* {
        reverse_proxy backend:3001 {
            trusted_proxies private_ranges
            header_up X-Real-IP {http.request.header.X-Forwarded-For}
        }
    }

    # Client dashboard
    handle {
        reverse_proxy client:3002
    }
}